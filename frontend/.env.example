# Example environment variables for the frontend (Vite)
# Copy this file to .env.local (or set these variables in your environment)

# Base URL of the backend API (obligatorio en Vercel / producción)
# Local:
VITE_API_URL=http://localhost:8081
# Producción (ejemplo):
# VITE_API_URL=https://spendlens-api.onrender.com

# Example overrides you may want in different environments
# VITE_FEATURE_FLAG=true
